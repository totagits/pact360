# PACT360 Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secrets for Security
JWT_SECRET=super_secret_pact360_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_pact360_refresh_token_key_54321

# Database Configuration
# Defaults to local SQLite file when using SQLite
DATABASE_URL="file:./dev.db"

# Production PostgreSQL URL (uncomment to override for production deployment)
# DATABASE_URL="postgresql://username:password@localhost:5432/pact360?schema=public"
